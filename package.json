{
  "name": "spydr",
  "productName": "SPYDR",
  "version": "0.1.0",
  "description": "Read-only Active Directory explorer for messy on-prem directories",
  "author": "SPYDR",
  "main": "./out/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "verify:fixture": "npx tsx electron/verify-fixture.ts",
    "test": "vitest run",
    "lab:up": "docker compose -f lab/docker-compose.yml up -d --build",
    "lab:seed": "docker compose -f lab/docker-compose.yml exec dc /lab/seed.sh",
    "lab:verify": "npx tsx lab/verify.ts",
    "lab:down": "docker compose -f lab/docker-compose.yml down",
    "lab:reset": "docker compose -f lab/docker-compose.yml down -v",
    "lab:logs": "docker compose -f lab/docker-compose.yml logs -f dc",
    "package": "npm run build && electron-builder --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "version:bump": "node scripts/version.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "cytoscape": "^3.32.0",
    "cytoscape-dagre": "^4.0.1",
    "cytoscape-fcose": "^2.2.0",
    "dagre": "^0.8.5",
    "graphology": "^0.25.4",
    "ldapts": "^7.4.0",
    "lucide-react": "^1.46.0",
    "lucide-static": "^1.46.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/cytoscape-dagre": "^2.3.4",
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
