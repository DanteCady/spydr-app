{
  "name": "spydr",
  "productName": "Spydr",
  "version": "0.1.0",
  "description": "Read-only Active Directory explorer for messy on-prem directories",
  "main": "./out/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "verify:fixture": "npx tsx electron/verify-fixture.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "cytoscape": "^3.32.0",
    "cytoscape-fcose": "^2.2.0",
    "graphology": "^0.25.4",
    "ldapts": "^7.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^36.2.0",
    "electron-vite": "^3.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  },
  "allowScripts": {
    "electron@36.9.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
